generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  createdAt     DateTime  @default(now())

  books         Book[]
  progress      Progress[]
  messages      Message[]
  notes         Note[]
  highlights    Highlight[]
  goal          Goal?
  preferences   Preferences?
  favorites     Favorite[]
  readingEvents ReadingEvent[]
}

model Book {
  id            String   @id @default(cuid())
  userId        String
  title         String
  author        String?
  fileName      String
  filePath      String
  fileType      String   @default("pdf")
  totalPages    Int      @default(0)
  previewText   String?
  uploadedAt    DateTime @default(now())

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress      Progress?
  messages      Message[]
  notes         Note[]
  highlights    Highlight[]
  favorites     Favorite[]
  readingEvents ReadingEvent[]

  @@index([userId])
  @@index([userId, title])
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  bookId      String   @unique
  currentPage Int      @default(1)
  percentage  Float    @default(0)
  status      String   @default("not_started")
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  content   String
  role      String   @default("user")
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId, createdAt])
}

model Note {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  page      Int
  text      String
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId, page])
}

model Highlight {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  page      Int
  text      String
  color     String   @default("yellow")
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId, page])
}

model Favorite {
  id     String @id @default(cuid())
  userId String
  bookId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

model Goal {
  id     String @id @default(cuid())
  userId String @unique
  type   String @default("pages")
  value  Int    @default(20)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Preferences {
  id              String  @id @default(cuid())
  userId          String  @unique
  theme           String  @default("light")
  font            String  @default("serif")
  fontSize        Int     @default(18)
  lineSpacing     Float   @default(1.6)
  background      String  @default("default")
  pageAnimation   String  @default("slide")
  scrollBehavior  String  @default("smooth")
  readerMode      String  @default("scroll")
  autoScroll      Boolean @default(false)
  autoScrollSpeed Int     @default(40)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReadingEvent {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  pages     Int      @default(0)
  minutes   Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
